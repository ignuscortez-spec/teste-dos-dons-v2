let current = 0;
let answers = new Array(180).fill(null);
let user = { name:'', phone:'', rede:'' };

function startTest() {
  const name = document.getElementById('user-name').value.trim();
  if (!name) { alert('Por favor, informe seu nome.'); document.getElementById('user-name').focus(); return; }
  user = { name, phone: document.getElementById('user-phone').value.trim(), rede: document.getElementById('user-rede').value };

  document.getElementById('screen-intro').classList.add('hidden');
  document.getElementById('screen-questions').classList.remove('hidden');
  document.getElementById('header-step').textContent = 'Respondendo...';
  renderQ();
}

function renderQ() {
  const q = PERGUNTAS[current];
  const bloco = BLOCOS_DATA[q.bloco - 1];
  
  let formatted = `<div class="text-xs sm:text-sm font-bold text-orange uppercase tracking-wider mb-1">${bloco.titulo}</div>`;
  if (bloco.subtitulo) {
    formatted += `<div class="text-xs font-semibold text-slate-500 italic mb-2">${bloco.subtitulo}</div>`;
  }
  formatted += `<div class="text-base sm:text-lg font-bold text-slate-900 leading-snug"><span class="text-orange mr-1.5">${q.num}.</span>${q.texto.replace(/^\.\.\./, '').replace(/^\.\./, '')}</div>`;

  document.getElementById('q-text').innerHTML = formatted;
  document.getElementById('q-instrucao').textContent = '💡 ' + bloco.instrucao;
  
  const pct = Math.round(current / 180 * 100);
  document.getElementById('progress-percent').textContent = pct + '%';
  document.getElementById('progress-bar').style.width = pct + '%';
  document.getElementById('progress-text').textContent = `Pergunta ${current+1} de 180`;
  document.getElementById('bloco-label').textContent = `Bloco ${q.bloco} de 6`;
  document.getElementById('bloco-titulo').textContent = bloco.titulo;

  const container = document.getElementById('options-container');
  container.innerHTML = '';
  
  bloco.opcoes.forEach(opt => {
    const isChecked = (answers[current] === opt.val);
    const div = document.createElement('div');
    div.innerHTML = `
      <input type="radio" name="answer" id="ans-${opt.val}" value="${opt.val}" class="hidden" onchange="enableNext()" ${isChecked ? 'checked' : ''}>
      <label for="ans-${opt.val}" class="flex flex-col items-center justify-center p-2.5 sm:p-3 rounded-xl border-2 border-slate-200 cursor-pointer hover:bg-slate-50 transition text-center h-full ${isChecked ? 'border-orange bg-amber-50 font-bold shadow-sm' : ''}">
        <span class="text-xs sm:text-sm font-bold text-slate-800 leading-tight">${opt.label}</span>
        <span class="text-[9px] text-slate-500 mt-1">(${opt.desc})</span>
      </label>
    `;
    container.appendChild(div);
  });

  if (answers[current] !== null) { enableBtn(true); } else { enableBtn(false); }

  document.getElementById('btn-prev').classList.toggle('invisible', current === 0);
  document.getElementById('btn-next').textContent = current === 179 ? 'Ver Resultados' : 'Próxima →';
}

function enableNext() {
  const sel = document.querySelector('input[name="answer"]:checked');
  if (sel) { 
    answers[current] = parseInt(sel.value); 
    enableBtn(true);
    document.querySelectorAll('#options-container label').forEach(l => {
      l.classList.remove('border-orange', 'bg-amber-50', 'font-bold', 'shadow-sm');
    });
    const lbl = document.querySelector(`label[for="${sel.id}"]`);
    if (lbl) {
      lbl.classList.add('border-orange', 'bg-amber-50', 'font-bold', 'shadow-sm');
    }
  }
}

function enableBtn(on) {
  const b = document.getElementById('btn-next');
  b.disabled = !on;
  b.classList.toggle('opacity-50', !on);
  b.classList.toggle('cursor-not-allowed', !on);
}

function nextQuestion() { 
  if (answers[current] === null) return; 
  if (current < 179) { 
    current++; 
    renderQ(); 
    window.scrollTo({top:0, behavior:'smooth'}); 
  } else { 
    showResults(); 
  } 
}

function prevQuestion() { 
  if (current > 0) { 
    current--; 
    renderQ(); 
    window.scrollTo({top:0, behavior:'smooth'}); 
  } 
}

function calcScores() {
  return DONS_MAP.map(don => {
    const totalA = don.perguntas.reduce((s, pn) => s + (answers[pn-1] || 0), 0);
    // Total B: colunas 2 e 6 (perguntas dos blocos 2 e 6, índices 1 e 5 do array de 6 perguntas)
    const totalB = [1, 5].reduce((s, b) => { const idx = don.perguntas[b]; return s + (answers[idx-1] || 0); }, 0);
    return { ...don, totalA, totalB };
  });
}

function showResults() {
  document.getElementById('screen-questions').classList.add('hidden');
  document.getElementById('screen-results').classList.remove('hidden');
  document.getElementById('header-step').textContent = 'Resultado';
  document.getElementById('res-name').textContent = user.name;
  document.getElementById('res-rede').textContent = user.rede;

  const scores = calcScores();
  const byA = [...scores].sort((a,b) => b.totalA - a.totalA);
  const manifestos = byA.slice(0, 5);
  const latentes = [...scores].sort((a,b) => b.totalB - a.totalB)
                              .filter(d => !manifestos.some(m => m.id === d.id))
                              .slice(0, 5);

  const renderCard = (d, tipo) => {
    const desc = DONS_DESC[d.id] || {};
    const pts = tipo === 'manifesto' ? d.totalA : d.totalB;
    const max = tipo === 'manifesto' ? 24 : 8;
    const pct = Math.round(pts / max * 100);
    const color = tipo === 'manifesto' ? '#173627' : '#e06d10';
    const bg = tipo === 'manifesto' ? 'bg-emerald-50 border-emerald-200' : 'bg-amber-50 border-amber-200';
    return `<div class="${bg} border rounded-xl p-4 flex flex-col gap-2">
      <div class="flex justify-between items-start">
        <h4 class="font-bold text-slate-900 text-sm">${d.nome}</h4>
        <span class="text-white text-[10px] font-extrabold px-2 py-0.5 rounded-full" style="background:${color}">${pts} / ${max} pts</span>
      </div>
      <div class="w-full bg-slate-200 rounded-full h-1.5">
        <div class="h-1.5 rounded-full" style="width:${pct}%;background:${color}"></div>
      </div>
      <p class="text-[10px] font-semibold" style="color:${color}">📖 ${desc.versiculo||''}</p>
      <p class="text-xs text-slate-700 leading-relaxed">${desc.descricao||''}</p>
      <div class="pt-2 border-t border-slate-200 text-[10px]">
        <strong style="color:${color}">Onde servir:</strong> <span class="text-slate-600">${desc.redes||''}</span>
      </div>
    </div>`;
  };

  document.getElementById('manifestos').innerHTML = manifestos.map(d => renderCard(d,'manifesto')).join('');
  document.getElementById('latentes').innerHTML = latentes.map(d => renderCard(d,'latente')).join('');

  const ctx = document.getElementById('chartDons').getContext('2d');
  new Chart(ctx, {
    type: 'bar',
    data: {
      labels: byA.map(d => d.nome.length > 18 ? d.nome.substring(0,16)+'…' : d.nome),
      datasets: [{
        data: byA.map(d => d.totalA),
        backgroundColor: byA.map((d,i) => i < 5 ? '#173627' : i < 10 ? '#e06d10' : '#cbd5e1'),
        borderRadius: 3
      }]
    },
    options: { 
      responsive: true, 
      maintainAspectRatio: false,
      plugins: { legend: { display: false }, tooltip: { callbacks: { label: ctx => ` ${ctx.raw} / 24 pts` } } },
      scales: { y: { beginAtZero: true, max: 24, ticks: { stepSize: 4 } }, x: { ticks: { font: { size: 8 }, maxRotation: 70, minRotation: 50 } } }
    }
  });
  window.scrollTo({top: 0, behavior: 'smooth'});
}

function shareWhatsApp() {
  const scores = calcScores().sort((a,b) => b.totalA - a.totalA);
  const top5 = scores.slice(0,5).map((d,i) => `${i+1}. *${d.nome}* (${d.totalA}/24 pts)`).join('\n');
  const lat5 = scores.filter(d=>!scores.slice(0,5).some(m=>m.id===d.id)).slice(0,5).map((d,i) => `${i+1}. *${d.nome}* (${d.totalB}/8 pts)`).join('\n');
  const msg = `*TESTE DOS DONS — IPI O CAMINHO*\n👤 *Nome:* ${user.name}\n🏛️ *Rede:* ${user.rede}\n\n🌟 *DONS MANIFESTOS (Top 5):*\n${top5}\n\n🌱 *DONS LATENTES (Potencial):*\n${lat5}\n\n_Questionário oficial de 180 afirmações (Christian A. Schwarz) · O Caminho do Servo · IPI Arapongas-PR_`;
  window.open(`https://api.whatsapp.com/send?text=${encodeURIComponent(msg)}`, '_blank');
}
</script>
