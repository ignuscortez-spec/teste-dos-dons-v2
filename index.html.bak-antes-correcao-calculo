<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Teste dos Dons Espirituais | IPI O Caminho</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Cinzel:wght@600;700&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'Plus Jakarta Sans', sans-serif; background: #f6f8f5; -webkit-tap-highlight-color: transparent; }
    .font-brand { font-family: 'Cinzel', serif; }
    :root { --green: #173627; --orange: #e06d10; }
    .bg-green { background-color: var(--green); }
    .text-green { color: var(--green); }
    .border-green { border-color: var(--green); }
    .bg-orange { background-color: var(--orange); }
    .text-orange { color: var(--orange); }
    .border-orange { border-color: var(--orange) !important; }
    .progress-bar { transition: width .35s ease; }
    @media print {
      header, #screen-intro, #screen-questions, .no-print { display: none !important; }
      #screen-results { display: block !important; }
    }
  </style>
</head>
<body class="min-h-screen flex flex-col text-slate-800">

<!-- HEADER -->
<header class="bg-green text-white border-b-4 sticky top-0 z-50 shadow-md" style="border-color:var(--orange)">
  <div class="max-w-3xl mx-auto px-4 py-2.5 flex items-center justify-between">
    <div class="flex items-center gap-3">
      <span class="flex items-center justify-center bg-white rounded-md shadow-sm shrink-0" style="height:42px;width:36px;padding:3px">
        <img src="logo-oficial-arco.png" alt="IPI O Caminho" style="height:100%;width:auto;display:block;object-fit:contain">
      </span>
      <div>
        <h1 class="text-xs sm:text-sm font-bold tracking-wider text-amber-400 font-brand">O CAMINHO</h1>
        <p class="text-[10px] sm:text-[11px] text-emerald-100">IPI Arapongas · Teste dos Dons Espirituais</p>
      </div>
    </div>
    <span id="header-step" class="text-[11px] bg-emerald-950/70 text-emerald-200 border border-emerald-700/50 px-2.5 py-1 rounded-full font-semibold">O Caminho do Servo</span>
  </div>
</header>

<main class="flex-1 max-w-3xl w-full mx-auto p-4 sm:p-6">

  <!-- TELA 1: INTRO -->
  <section id="screen-intro" class="bg-white rounded-2xl shadow-sm border border-slate-200 p-5 sm:p-8">
    <div class="text-center max-w-xl mx-auto mb-6">
      <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 mb-2">Descubra os Seus Dons Espirituais</h2>
      <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">
        Questionário oficial de <strong>Christian A. Schwarz</strong> com <strong>180 afirmações</strong> distribuídas em 6 dimensões de avaliação vocacional — identificando com fidelidade matemática seus
        <span class="text-green font-bold">Dons Manifestos</span> (em pleno fruto) e
        <span class="text-orange font-bold">Dons Latentes</span> (potencial vocacional e aspiração).
      </p>
    </div>
    <div class="grid grid-cols-3 gap-3 mb-6 max-w-lg mx-auto text-center">
      <div class="bg-slate-50 rounded-xl border border-slate-200 p-3">
        <div class="text-xl font-extrabold text-green">180</div>
        <div class="text-[10px] text-slate-600 font-semibold">Afirmações</div>
      </div>
      <div class="bg-slate-50 rounded-xl border border-slate-200 p-3">
        <div class="text-xl font-extrabold text-green">30</div>
        <div class="text-[10px] text-slate-600 font-semibold">Dons bíblicos</div>
      </div>
      <div class="bg-slate-50 rounded-xl border border-slate-200 p-3">
        <div class="text-xl font-extrabold text-green">~15min</div>
        <div class="text-[10px] text-slate-600 font-semibold">Estimado</div>
      </div>
    </div>
    <div class="bg-slate-50 rounded-xl p-4 sm:p-5 border border-slate-200 max-w-lg mx-auto mb-6">
      <h3 class="text-xs font-bold text-slate-700 uppercase tracking-wider mb-3">Sua Identificação</h3>
      <div class="space-y-3">
        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Nome Completo *</label>
          <input type="text" id="user-name" class="w-full px-3.5 py-2.5 text-sm rounded-xl border border-slate-300 focus:ring-2 focus:ring-amber-500 focus:outline-none bg-white" placeholder="Seu nome completo">
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div>
            <label class="block text-xs font-semibold text-slate-700 mb-1">WhatsApp</label>
            <input type="tel" id="user-phone" class="w-full px-3.5 py-2.5 text-sm rounded-xl border border-slate-300 focus:ring-2 focus:ring-amber-500 focus:outline-none bg-white" placeholder="(43) 99999-0000">
          </div>
          <div>
            <label class="block text-xs font-semibold text-slate-700 mb-1">Rede / Ministério</label>
            <select id="user-rede" class="w-full px-3.5 py-2.5 text-sm rounded-xl border border-slate-300 focus:ring-2 focus:ring-amber-500 focus:outline-none bg-white">
              <option>Conselho</option>
              <option>01 IPI KIDS</option>
              <option>02 RISE UP (Adolescentes)</option>
              <option>03 NEXT (Jovens)</option>
              <option>04 LEGADO (Homens)</option>
              <option>05 ESTER (Mulheres)</option>
              <option>06 ONE (Casais)</option>
              <option>07 MELHOR IDADE</option>
              <option>Louvor e Adoração</option>
              <option>Diaconia / MASD</option>
              <option>Células / Integração</option>
              <option>Membro / Sem ministério fixo</option>
            </select>
          </div>
        </div>
      </div>
    </div>
    <div class="max-w-lg mx-auto">
      <button onclick="startTest()" class="w-full bg-green hover:opacity-90 text-white font-bold py-3.5 px-6 rounded-xl shadow-md transition flex items-center justify-center gap-2 text-sm sm:text-base border-b-2" style="border-color:var(--orange)">
        <span>Iniciar o Teste dos Dons</span>
        <svg class="w-5 h-5 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
      </button>
      <p class="text-center text-[11px] text-slate-500 mt-3">Suas respostas ficam salvas no navegador caso precise pausar.</p>
    </div>
  </section>

  <!-- TELA 2: QUESTIONÁRIO -->
  <section id="screen-questions" class="hidden bg-white rounded-2xl shadow-sm border border-slate-200 p-5 sm:p-7">

    <!-- PROGRESSO -->
    <div class="mb-5">
      <div class="flex justify-between items-center text-xs font-semibold text-slate-500 mb-1.5">
        <span id="progress-text" class="font-bold text-slate-800">Pergunta 1 de 180</span>
        <span id="progress-percent" class="text-orange font-bold">0%</span>
      </div>
      <div class="w-full bg-slate-100 h-2.5 rounded-full overflow-hidden">
        <div id="progress-bar" class="h-full progress-bar rounded-full" style="width:0%;background:linear-gradient(90deg,#173627,#e06d10)"></div>
      </div>
      <div class="flex justify-between mt-1.5">
        <span id="bloco-label" class="text-[10px] text-slate-500 font-medium">Bloco 1 de 6</span>
        <span id="bloco-titulo" class="text-[10px] font-bold text-orange"></span>
      </div>
    </div>

    <!-- CARD DA PERGUNTA -->
    <div class="min-h-[280px] flex flex-col justify-between">
      <div>
        <div id="q-text" class="mb-3 leading-relaxed min-h-[70px]">Carregando...</div>
        <p id="q-instrucao" class="text-[11px] text-slate-600 mb-4 bg-slate-50 p-2.5 rounded-lg border border-slate-200"></p>

        <!-- ESCALA 5 NÍVEIS DINÂMICA -->
        <div id="options-container" class="grid grid-cols-1 sm:grid-cols-5 gap-2"></div>
      </div>

      <!-- BOTÕES -->
      <div class="flex justify-between items-center pt-5 mt-5 border-t border-slate-100">
        <button id="btn-prev" onclick="prevQuestion()" class="text-slate-500 hover:text-slate-800 text-xs font-bold px-3 py-2 rounded-lg transition invisible">← Voltar</button>
        <button id="btn-next" onclick="nextQuestion()" disabled class="bg-green text-white font-bold text-xs sm:text-sm px-6 py-2.5 rounded-xl shadow transition opacity-50 cursor-not-allowed">Próxima →</button>
      </div>
    </div>
  </section>

  <!-- TELA 3: RESULTADOS -->
  <section id="screen-results" class="hidden space-y-5">
    <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-5 sm:p-8 relative overflow-hidden">
      <div class="absolute top-0 left-0 right-0 h-2" style="background:linear-gradient(90deg,#173627,#e06d10,#173627)"></div>
      <div class="text-center mb-6">
        <span class="inline-block px-3 py-1 bg-emerald-100 text-green rounded-full text-[10px] font-extrabold uppercase tracking-wider mb-2">Relatório Oficial de Dons</span>
        <h2 class="text-xl sm:text-2xl font-bold text-slate-900 font-brand">Seus Dons Espirituais</h2>
        <p class="text-xs text-slate-600 mt-1">Membro: <strong id="res-name"></strong> · <span id="res-rede"></span></p>
      </div>

      <!-- QUADRO A -->
      <div class="mb-8">
        <div class="flex items-center gap-2 border-b-2 border-green pb-2 mb-3">
          <span class="text-lg">🌟</span>
          <h3 class="text-sm sm:text-base font-bold text-slate-900 uppercase tracking-wide">Quadro A — 5 Dons Manifestos</h3>
        </div>
        <p class="text-xs text-slate-500 mb-4">Dons com maior pontuação total nas 6 dimensões (0 a 24 pontos por dom):</p>
        <div id="manifestos" class="grid grid-cols-1 sm:grid-cols-2 gap-3"></div>
      </div>

      <!-- QUADRO B -->
      <div class="mb-8">
        <div class="flex items-center gap-2 border-b-2 border-orange pb-2 mb-3">
          <span class="text-lg">🌱</span>
          <h3 class="text-sm sm:text-base font-bold text-slate-900 uppercase tracking-wide">Quadro B — 5 Dons Latentes</h3>
        </div>
        <p class="text-xs text-slate-500 mb-4">Potencial vocacional medido pela soma das colunas de <em>vontade de envolvimento</em> e <em>disposição interna</em> (0 a 8 pontos):</p>
        <div id="latentes" class="grid grid-cols-1 sm:grid-cols-2 gap-3"></div>
      </div>

      <!-- GRÁFICO -->
      <div class="bg-slate-50 rounded-xl p-4 border border-slate-200 mb-6">
        <h3 class="text-xs font-bold text-slate-800 uppercase tracking-wide mb-2">📊 Mapeamento Geral dos 30 Dons (Total A)</h3>
        <div class="h-64 sm:h-80"><canvas id="chartDons"></canvas></div>
      </div>

      <!-- AÇÕES -->
      <div class="flex flex-col sm:flex-row gap-3 no-print">
        <button onclick="shareWhatsApp()" class="flex-1 bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-3 px-5 rounded-xl shadow transition flex items-center justify-center gap-2 text-xs sm:text-sm">
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          <span>Enviar à Liderança</span>
        </button>
        <button onclick="window.print()" class="bg-slate-800 hover:bg-slate-900 text-white font-bold py-3 px-5 rounded-xl shadow transition flex items-center justify-center gap-2 text-xs sm:text-sm">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"/></svg>
          <span>Imprimir / Salvar PDF</span>
        </button>
      </div>
    </div>
  </section>

</main>

<footer class="bg-white border-t border-slate-200 py-3 text-center text-[11px] text-slate-500">
  Igreja Presbiteriana Independente — <strong>IPI O Caminho (Arapongas-PR)</strong> · <em>O Caminho do Servo</em> (Christian A. Schwarz)
</footer>

